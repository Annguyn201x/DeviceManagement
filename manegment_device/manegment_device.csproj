<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <StartupObject>manegment_device.Program</StartupObject>
        <UseAppHost>true</UseAppHost>
        <BaseOutputPath>..\_home-theme-build\</BaseOutputPath>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Guna.UI2.WinForms" Version="2.0.4.8" />
      <PackageReference Include="MySql.Data" Version="26.7.0" />
      <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
      <PackageReference Include="ReaLTaiizor" Version="3.8.2.1" />
    </ItemGroup>

    <ItemGroup>
      <!-- Keep the delivered Water Monitor project as a source reference; its own app entry point and generated files are not compiled into this host app. -->
      <Compile Remove="water_monitor_desktop_ui/**/*.cs" />
      <Compile Update="Device.cs">
        <DependentUpon>Manager_device.cs</DependentUpon>
      </Compile>
      <Compile Update="Hash.cs">
        <DependentUpon>Program.cs</DependentUpon>
      </Compile>
      <Compile Update="Information_device.cs">
        <DependentUpon>Manager_device.cs</DependentUpon>
      </Compile>
      <Compile Update="user_backend.cs">
        <DependentUpon>Program.cs</DependentUpon>
      </Compile>
      <Compile Update="lake.cs">
        <DependentUpon>Manager_device.cs</DependentUpon>
      </Compile>
      <Compile Update="Login_query.cs">
        <DependentUpon>login_form.cs</DependentUpon>
      </Compile>
      <Compile Update="Search_History.cs">
        <DependentUpon>Program.cs</DependentUpon>
      </Compile>
      <Compile Update="login_form.cs">
        <SubType>Form</SubType>
        <DependentUpon>Program.cs</DependentUpon>
      </Compile>
      <Compile Update="UserControl1.cs">
        <SubType>UserControl</SubType>
      </Compile>
      <Compile Update="Sign_form.cs">
        <SubType>Form</SubType>
        <DependentUpon>Program.cs</DependentUpon>
      </Compile>
      <Compile Update="Home.cs">
        <SubType>Form</SubType>
        <DependentUpon>Program.cs</DependentUpon>
      </Compile>
      <Compile Update="ADD_IP_device.cs">
        <SubType>Form</SubType>
        <DependentUpon>Program.cs</DependentUpon>
      </Compile>
      <Compile Update="Manager_device.cs">
        <SubType>Form</SubType>
        <DependentUpon>Program.cs</DependentUpon>
      </Compile>
      <Compile Update="CurrentUser.cs">
        <DependentUpon>Manager_device.cs</DependentUpon>
      </Compile>
      <Compile Update="Menuu.cs">
        <SubType>Form</SubType>
        <DependentUpon>Program.cs</DependentUpon>
      </Compile>
      <Compile Update="business_query_device.cs">
        <DependentUpon>ADD_IP_device.cs</DependentUpon>
      </Compile>
      <Compile Update="Tool_manerger.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="Sign_query.cs">
        <DependentUpon>Sign_form.cs</DependentUpon>
      </Compile>
      <Compile Update="ILogin_query.cs">
        <DependentUpon>login_form.cs</DependentUpon>
      </Compile>
      <Compile Update="ISign_query.cs">
        <DependentUpon>Sign_form.cs</DependentUpon>
      </Compile>
      <Compile Update="IDashboard.cs">
        <DependentUpon>Menuu.cs</DependentUpon>
      </Compile>
      <Compile Update="Dashboard_query.cs">
        <DependentUpon>Menuu.cs</DependentUpon>
      </Compile>
      <Compile Update="UIHelpers.cs">
        <DependentUpon>Menuu.cs</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <None Update="Sign_HTML.html">
        <DependentUpon>Sign_form.cs</DependentUpon>
      </None>
    </ItemGroup>

</Project>
